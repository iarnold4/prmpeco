---
// Base layout for every page: head, header, the page's own content, footer.
// Pages put their title and meta in <Fragment slot="head"> (or use layouts/Page.astro).
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site.js';

interface Props {
  bodyClass?: string;
}
const { bodyClass } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta property="og:locale" content="en_US" />
<meta property="og:site_name" content={site.name} />
<meta name="twitter:card" content="summary_large_image" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<slot name="head" />
</head>
<body class:list={['min-h-screen bg-white', bodyClass]}>
<Header />
<main id="content"><slot /></main>
<Footer />
<script is:inline src="/js/menu.js" defer></script>
</body>
</html>
