---
// Site header: a white bar (the wordmark's "PRM" letters are filled white, so the logo is made for a white ground),
// the colour logo, the four page links in navy with a yellow underline on the current page, sticky as on the sibling
// sites. On small screens the hamburger opens the menu list under the bar (public/js/menu.js, classes pe-*).
// No dropdowns: the site has four pages.
import { mainMenu } from '../data/navigation.js';
import { isCurrent } from '../lib/nav.js';

const path = Astro.url.pathname;
const items = mainMenu.map((item) => ({ ...item, current: isCurrent(item.href, path) }));
---
<a class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-[60] focus:rounded focus:bg-white focus:px-3 focus:py-2 focus:shadow" href="#content">Skip to content</a>
<header class="pe-header sticky top-0 z-50 bg-white shadow-md">
	<div class="container-site">
		<div class="flex h-20 items-center justify-between gap-4">
			<a href="/" class="block shrink-0 no-underline" aria-label="PRMPECO home">
				<img src="/images/logo.png" width="1051" height="262" alt="PRMPECO, powered by PRM Filtration" class="h-11 w-auto sm:h-12 lg:h-14" />
			</a>

			<nav class="hidden items-center gap-2 lg:flex" aria-label="Main menu">
				{items.map((item) => (
					<a
						href={item.href}
						class:list={['px-3 py-2 font-semibold text-brand-navy no-underline decoration-brand-yellow decoration-4 underline-offset-8 hover:underline', item.current && 'underline']}
						aria-current={item.current ? 'page' : undefined}
					>{item.label}</a>
				))}
			</nav>

			<button class="pe-burger cursor-pointer rounded p-2 text-brand-navy hover:bg-brand-navy/10 lg:hidden" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="pe-menu">
				<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
			</button>
		</div>

		<!-- small screens: the menu list under the bar (menu.js toggles .is-open) -->
		<ul class="pe-menu hidden flex-col border-t border-brand-navy/15 pb-4 pt-2 lg:hidden!" id="pe-menu">
			{items.map((item) => (
				<li>
					<a
						href={item.href}
						class:list={['block px-2 py-2.5 font-semibold text-brand-navy no-underline', item.current && 'underline decoration-brand-yellow decoration-4 underline-offset-8']}
						aria-current={item.current ? 'page' : undefined}
					>{item.label}</a>
				</li>
			))}
		</ul>
	</div>
</header>

<style>
	@media (max-width: 63.99rem) {
		.pe-menu.is-open { display: flex; }
	}
</style>
