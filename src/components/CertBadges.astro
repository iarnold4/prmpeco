---
// The brief's certification callouts, each with its one-line description from the brief. By default the three
// certifications the brief asks to badge "across the capabilities and homepage sections" (UL 508A, UL 698A and the
// Third-Party system certification); `all` adds the fourth manufacturing item, In-House Fabrication, for the
// Capabilities page. Text marks only: UL's own badge artwork needs UL's permission and the file, neither of which
// the site has.
import { certifications, manufacturing } from '../data/capabilities.js';

interface Props {
  all?: boolean; // all four manufacturing items, not just the three certifications
  columns?: string; // the grid's column classes (default: three across from md)
  class?: string;
}
const { all = false, columns = 'md:grid-cols-3', class: className } = Astro.props;
const items = all ? manufacturing.items : certifications;

// one icon per item: a control panel, a bolt, a check badge, a wrench
const icons = [
  '<rect x="4" y="4" width="16" height="16" rx="2" /><rect x="9" y="9" width="6" height="6" /><path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2" />',
  '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z" />',
  '<path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z" /><path d="m9 12 2 2 4-4" />',
  '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />',
];
---
<ul class:list={['grid gap-6', columns, className]}>
	{items.map((c, i) => (
		<li class="flex gap-4">
			<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-brand-navy text-brand-yellow" aria-hidden="true">
				<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[i]}></svg>
			</span>
			<div>
				<h3 class="font-bold text-gray-900">{c.label}</h3>
				<p class="mt-1 text-sm leading-relaxed text-gray-600">{c.text}</p>
			</div>
		</li>
	))}
</ul>
